{
  "name": "besmir-spitex-template",
  "version": "0.0.1",
  "private": true,
  "description": "SvelteKit and Tauri app for simplified Spitex scheduling with clients, PDF, Excel and sync.",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "10.29.1"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "dev:desktop": "node scripts/run-with-env.mjs dev",
    "build": "pnpm build:web",
    "build:web": "cross-env BUILD_TARGET=web VITE_BUILD_TARGET=web svelte-kit sync && cross-env BUILD_TARGET=web VITE_BUILD_TARGET=web vite build",
    "build:desktop": "node scripts/run-with-env.mjs build",
    "preview": "vite preview --host 0.0.0.0",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "pnpm tauri:build && pnpm windows:stage",
    "windows:stage": "node scripts/stage-windows-installer.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.6.2",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.0.11",
    "vitest": "^4.1.6"
  }
}
