{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Besmir Spitex Einsatzplanung",
  "version": "0.1.1",
  "identifier": "ch.besi94.besmir",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Besmir Spitex Einsatzplanung",
        "url": "/",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["msi", "nsis"],
    "windows": {
      "wix": {
        "language": "de-DE"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
