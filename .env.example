# Besmir - example environment variables
# Copy to .env and fill in real values.

# Google Maps server-side key (Geocoding + Distance Matrix)
GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key

# Google Maps browser key (Places Autocomplete)
# For a shared key, use the same value as GOOGLE_MAPS_API_KEY.
PUBLIC_GOOGLE_MAPS_API_KEY=your_public_google_maps_api_key

# Optional custom cache file location for Google responses
GOOGLE_CACHE_FILE=./data/google-cache.json

# Server persistence and authenticated desktop sync
DATABASE_URL=postgres://postgres:postgres@localhost:5432/besmir
SYNC_API_TOKEN=replace_with_long_random_token

# Runtime
PORT=3000
NODE_ENV=development

# App metadata
APP_BASE_PATH=/besmir
